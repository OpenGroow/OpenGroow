apps/openclaw-connect/missions
apps/openclaw-connect/*.jpg
apps/openclaw-connect/output/*.jpg

# Local env / editor state
.env
**/.env
.env.*
**/.env.*
!.env.local.example
!**/.env.local.example
!.env.production.example
!**/.env.production.example
.idea
.vscode
