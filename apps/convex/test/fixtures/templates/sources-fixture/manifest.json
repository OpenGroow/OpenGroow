{
  "id": "sources-fixture",
  "name": "Sources fixture",
  "description": "Test fixture: a Template declaring three Sources, one with enrichment and one with a platform.",
  "category": "test",
  "visibility": "development",
  "mcpServers": [
    {
      "name": "analysis-mcp",
      "transport": "streamable-http",
      "url": "http://host.docker.internal:4000/mcp",
      "activationUrl": "http://localhost:4000/mcp"
    }
  ],
  "missionTypes": [],
  "jobTypes": [
    {
      "type": "source_ingestion",
      "sourceTypes": [
        "keyword",
        "post",
        "reel"
      ]
    }
  ],
  "sources": [
    {
      "type": "keyword",
      "label": "Search keyword",
      "family": "search",
      "agentsMd": "sources/keyword.md",
      "analysisSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "volume": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "post",
      "label": "Social post",
      "family": "social-video",
      "agentsMd": "sources/post.md",
      "platform": {
        "name": "Instagram",
        "pageHosts": [
          "instagram.com"
        ],
        "originPattern": "^instagram\\.com/(?:[^/]+/)?(?:p|reels?|tv)/([A-Za-z0-9_-]+)"
      },
      "analysisSchema": {
        "type": "object",
        "properties": {
          "hook": {
            "type": "string"
          }
        }
      }
    },
    {
      "type": "reel",
      "label": "Video post",
      "family": "social-video",
      "agentsMd": "sources/reel.md",
      "analysisSchema": {
        "type": "object",
        "properties": {
          "hook": {
            "type": "string"
          }
        },
        "required": [
          "hook"
        ]
      }
    }
  ],
  "externalJobsBySource": {
    "reel": {
      "analyze": {
        "server": "analysis-mcp",
        "mcpTool": "get_status",
        "statusField": "status",
        "terminalStates": {
          "completed": [
            "completed"
          ],
          "failed": [
            "failed"
          ]
        }
      }
    }
  }
}
