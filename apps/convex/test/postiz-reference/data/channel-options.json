{
  "schemaVersion": 1,
  "adapter": "postiz",
  "platforms": {
    "tiktok": [
      {
        "key": "privacy_level",
        "label": "Visibility",
        "type": "select",
        "default": "PUBLIC_TO_EVERYONE",
        "options": [
          {
            "value": "PUBLIC_TO_EVERYONE",
            "label": "Everyone"
          },
          {
            "value": "MUTUAL_FOLLOW_FRIENDS",
            "label": "Friends (mutual follows)"
          },
          {
            "value": "FOLLOWER_OF_CREATOR",
            "label": "Followers"
          },
          {
            "value": "SELF_ONLY",
            "label": "Only me"
          }
        ]
      },
      {
        "key": "content_posting_method",
        "label": "Posting method",
        "type": "select",
        "default": "DIRECT_POST",
        "options": [
          {
            "value": "DIRECT_POST",
            "label": "Publish directly"
          },
          {
            "value": "UPLOAD",
            "label": "Send to the TikTok inbox (publish it in the app within 24h)"
          }
        ]
      },
      {
        "key": "comment",
        "label": "Allow comments",
        "type": "boolean",
        "default": true
      },
      {
        "key": "duet",
        "label": "Allow duets (videos)",
        "type": "boolean",
        "default": true
      },
      {
        "key": "stitch",
        "label": "Allow stitches (videos)",
        "type": "boolean",
        "default": true
      }
    ],
    "instagram": [
      {
        "key": "post_type",
        "label": "Post type",
        "type": "select",
        "default": "post",
        "options": [
          {
            "value": "post",
            "label": "Feed post or Reel"
          },
          {
            "value": "story",
            "label": "Story"
          }
        ]
      }
    ],
    "pinterest": [
      {
        "key": "board",
        "label": "Board ID",
        "type": "text",
        "placeholder": "1234567890123456789"
      }
    ]
  }
}
