# =============================================================================
# @opengroow/convex-app local env
# Copy to .env.local and fill values.
# =============================================================================

# Public app origin used by Better Auth (the dashboard is the auth origin).
DASHBOARD_URL=http://localhost:3912

# Broker
BROKER_URL=http://127.0.0.1:4300
BROKER_KEY_ID=convex
BROKER_SECRET=convex-secret

# Instance provisioner: "control-plane" (default; remote service speaking the
# HMAC-signed API of docs/CONTROL_PLANE.md) or "local" (self-host, repoint the
# OPENCLAW_CONTROL_* vars at apps/openclaw-local-control: http://localhost:4610,
# key id/secret "convex"/"convex-secret" by default). The same three
# OPENCLAW_CONTROL_* vars serve both.
INSTANCE_PROVISIONER=control-plane
OPENCLAW_CONTROL_URL=http://127.0.0.1:4600
OPENCLAW_CONTROL_KEY_ID=convex
OPENCLAW_CONTROL_SECRET=convex-secret

# Set to 1 for self-host trust rules (outbound URL checks, scope reservation,
# MCP URL overrides). Not the provisioner selector: use INSTANCE_PROVISIONER.
# See ADR-033 (docs/adr/033-local-multi-is-the-only-self-host-provisioning-model.md).
IS_SELF_HOST=0
