# ─── Anthropic ────────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ─── OpenClaw Gateway ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=0.0.0.0

# ─── Directories ──────────────────────────────────────────────────────────────
OPENCLAW_CONFIG_DIR=/home/openclaw/.openclaw
OPENCLAW_WORKSPACE_DIR=/home/openclaw/.openclaw/workspace

# ─── Image registry ───────────────────────────────────────────────────────────
# Registry path the images are published under (no default), e.g.
# registry.example.com/<team>. Used by scripts/build-and-push*.sh.
OPENCLAW_IMAGE_REGISTRY=
# Image refs consumed by docker-compose.yml (digest recommended)
# OPENCLAW_IMAGE_REF=registry.example.com/<team>/openclaw-gateway@sha256:...
OPENCLAW_IMAGE_REF=
# OPENCLAW_RUNTIME_WORKER_IMAGE_REF=registry.example.com/<team>/openclaw-runtime-worker@sha256:...
