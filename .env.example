# =============================================================================
# OpenGroow — the ONE env file. Create it with `pnpm run setup` (or
# `cp .env.example .env`) at the repository root; nothing else to fill in.
# Read by `pnpm dev`, `pnpm dev:docker` and `docker compose up`.
#
# Provider keys of the agents (publishing, video generation, ...) are NOT set
# here: enter them per Project in the dashboard.
#
# Three sections: REQUIRED (preset, leave as is unless told otherwise),
# OPTIONAL (integrations, ports, URLs), GENERATED (created by the scripts, do
# not set).
# `pnpm dev` also needs Docker running; the Dashboard has email/password
# sign-up.
# =============================================================================

# ===== REQUIRED =====
# Layering of the compose files (leave as is). docker-compose.yml only adds
# the glue services (broker, dashboard, secret generation); the full stack is
# these files layered in order, like repeated `-f` flags.
COMPOSE_FILE=apps/convex/docker/docker-compose.yml:docker-compose.yml
COMPOSE_PATH_SEPARATOR=:

# ===== OPTIONAL =====
# Account mode: leave empty for single-account (default). Only the exact value
# `multi-account` opens registrations (hosted deployments). Any other non-empty
# value logs a warning and stays locked. This is a variable of the CONVEX
# deployment, not of the dashboard container:
#   npx convex env set OPENGROOW_ACCOUNT_MODE multi-account
OPENGROOW_ACCOUNT_MODE=

# Official OpenClaw Plugins, comma-separated: `codex` (ChatGPT subscription
# login), `whatsapp` (WhatsApp channel), `xiaomi` (Xiaomi provider) and `groq`
# (Groq speech-to-text). Empty by default: the image ships
# none of them. Instances install the listed ones at start and uninstall the
# others (removing WhatsApp also drops its channel config); the dashboard hides
# the features of the unlisted ones. Existing instances pick up a change on
# their next recreate (`pnpm --filter @opengroow/openclaw-local-control rollout`).
# Convex keeps its own copy, pushed by `pnpm dev` and the Docker bootstrap: after
# editing this line, restart them so Convex follows (ADR-068).
OPENCLAW_OPTIONAL_PLUGINS=

# Ports exposed on the host (see docs/PORTS.md). Override on collision.
DASHBOARD_PORT=3912
CONVEX_PORT=3210
CONVEX_SITE_PROXY_PORT=3211
CONVEX_DASHBOARD_PORT=6791
OPENCLAW_CONNECT_PORT=4700

# URLs as reached from outside the compose network (reverse proxy / domain).
# Read by the dashboard at request time (no rebuild needed): edit and restart.
DASHBOARD_URL=http://localhost:3912
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# Article MCP service (separate repo), used to preview article cover images.
NEXT_PUBLIC_SEO_MCP_URL=http://127.0.0.1:3500

# `pnpm start` only (stack from published images, see docs/START.md): registry
# and organization hosting the images, no scheme, no trailing slash,
# e.g. ghcr.io/<org>. No default on purpose. OPENCLAW_IMAGE_TAG defaults to latest.
OPENCLAW_IMAGE_REGISTRY=
OPENCLAW_IMAGE_TAG=
# `pnpm start` only: HMAC secret between Convex and openclaw-local-control (the
# container that mounts the Docker socket). `pnpm run setup` generates it; there
# is no default and `pnpm start` refuses to run without it.
OPENCLAW_START_CONTROL_SECRET=

# Lifetime of a "connect link" (Dashboard > Devices), in ms; 0 = never expires.
# Re-pushed to Convex on every start, so set it here, not via `convex env set`.
OPENCLAW_CONNECT_TICKET_TTL_MS=1800000

# ===== GENERATED, do not set =====
# Created by the scripts on first boot and kept in a Docker volume / the local
# Convex deployment. Setting them here has no effect or breaks auth:
#   BROKER_KEY_ID, BROKER_SECRET, BROKER_ADMIN_TOKEN, BETTER_AUTH_SECRET
#   CONVEX_TOKEN (admin key), CONVEX_DOCKER_URL
